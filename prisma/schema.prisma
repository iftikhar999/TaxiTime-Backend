generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model alarms {
  id             String        @id
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  companyId      String
  type           AlarmType
  severity       AlarmSeverity @default(MEDIUM)
  title          String
  description    String
  driverId       String?
  jobId          String?
  location       Json?
  status         AlarmStatus   @default(ACTIVE)
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  responseNotes  String?
  companies      companies     @relation(fields: [companyId], references: [id])
  users          User?         @relation(fields: [driverId], references: [id])
  jobs           Job?          @relation(fields: [jobId], references: [id])
}

model assignments {
  id              String           @id
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  jobId           String
  driverId        String
  assignedBy      String
  assignedAt      DateTime         @default(now())
  status          AssignmentStatus @default(ASSIGNED)
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  users           User             @relation(fields: [driverId], references: [id])
  jobs            Job              @relation(fields: [jobId], references: [id])

  @@unique([jobId, driverId], name: "jobId_driverId")
}

model billing_records {
  id                 Int                @id @default(autoincrement())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  companyId          String
  subscriptionPlanId Int
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  basePlanCost       Float              @default(0.0)
  vehicleCost        Float              @default(0.0)
  commissionAmount   Float              @default(0.0)
  setupFee           Float              @default(0.0)
  totalAmount        Float
  vehicleCount       Int                @default(0)
  driverCount        Int                @default(0)
  ridesCount         Int                @default(0)
  totalRevenue       Float              @default(0.0)
  status             String             @default("pending")
  dueDate            DateTime?
  paidAt             DateTime?
  companies          companies          @relation(fields: [companyId], references: [id])
  subscription_plans subscription_plans @relation(fields: [subscriptionPlanId], references: [id])
  company_payments   company_payments[]
  invoices           invoices?
}

model companies {
  id                               String                      @id
  createdAt                        DateTime                    @default(now())
  updatedAt                        DateTime
  deletedAt                        DateTime?
  tenantId                         String?
  legalName                        String?
  brandName                        String?
  companyCode                      String?                     @unique
  companyType                      String                      @default("TAXI_OPERATOR")
  businessModel                    String                      @default("B2C")
  registrationNumber               String?
  taxId                            String?
  primaryLanguage                  String                      @default("en")
  timezone                         String                      @default("UTC")
  status                           String                      @default("PENDING")
  activationDate                   DateTime?
  primaryContactName               String?
  primaryContactRole               String?
  primaryContactEmail              String?
  primaryContactPhone              String?
  supportEmail                     String?
  supportPhone                     String?
  billingEmail                     String?
  hqAddressLine1                   String?
  hqAddressLine2                   String?
  hqCity                           String?
  hqState                          String?
  hqPostcode                       String?
  hqCountry                        String?
  hqLatitude                       Float?
  hqLongitude                      Float?
  kycStatus                        String                      @default("PENDING")
  kycLastReviewedAt                DateTime?
  kycExpiryAt                      DateTime?
  docCertificateOfIncorporationUrl String?
  docTaxCertificateUrl             String?
  docInsurancePolicyUrl            String?
  docOperatingLicenseUrl           String?
  insurancePolicyNumber            String?
  insuranceExpiryDate              DateTime?
  permitNumber                     String?
  permitExpiryDate                 DateTime?
  serviceModes                     Json?
  operatingHoursJson               Json?
  holidayCalendarJson              Json?
  dispatchMode                     String                      @default("AUTO")
  autoAssignRadiusKm               Float                       @default(5.0)
  maxParallelOffers                Int                         @default(3)
  escalationSlaSeconds             Int                         @default(300)
  driverBreakPolicyJson            Json?
  vehicleAgeLimitYears             Int?                        @default(15)
  requiresVehicleInspection        Boolean                     @default(true)
  billingCycle                     String                      @default("MONTHLY")
  billingStartDate                 DateTime?
  billingCurrency                  String                      @default("USD")
  commissionModel                  String                      @default("PERCENTAGE")
  commissionRate                   Float                       @default(15.0)
  driverPayoutFrequency            String                      @default("WEEKLY")
  settlementThresholdAmount        Float                       @default(100.0)
  paymentGatewayAccountId          String?
  stripeConnectedAccountId         String?
  invoiceDeliveryMethod            String                      @default("EMAIL")
  latePaymentPolicyJson            Json?
  walletEnabled                    Boolean                     @default(false)
  walletTopupMinimum               Float                       @default(50.0)
  subscriptionPlanId               Int?
  subscriptionStartDate            DateTime?
  subscriptionEndDate              DateTime?
  trialEndDate                     DateTime?
  lastPaymentDate                  DateTime?
  nextBillingDate                  DateTime?
  suspendedAt                      DateTime?
  suspendedBy                      String?
  reactivatedAt                    DateTime?
  reactivatedBy                    String?
  subscriptionUpdatedAt            DateTime?
  subscriptionUpdatedBy            String?
  fleetSizeTotal                   Int                         @default(0)
  fleetCompanyOwnedCount           Int                         @default(0)
  fleetDriverOwnedCount            Int                         @default(0)
  fleetActiveVehicleCount          Int                         @default(0)
  fleetInserviceVehicleCount       Int                         @default(0)
  fleetOutofserviceVehicleCount    Int                         @default(0)
  fleetAvgVehicleAgeYears          Float                       @default(0)
  fleetHasEvCount                  Int                         @default(0)
  voipProvider                     String?
  voipAccountId                    String?
  voipMaskingEnabled               Boolean                     @default(false)
  cctvProvider                     String?
  cctvAccountId                    String?
  telematicsProvider               String?
  telematicsApiKey                 String?
  smsSenderId                      String?
  emailSenderDomain                String?
  webhookEndpointUrl               String?
  webhookSecret                    String?
  apiClientId                      String?
  apiClientSecretHash              String?
  kpiTargetsJson                   Json?
  alertRecipientEmails             String[]
  alertRecipientSms                String[]
  panicEscalationContactsJson      Json?
  reportingTimezone                String                      @default("UTC")
  dataRetentionDays                Int                         @default(2555)
  gdprContactEmail                 String?
  name                             String?
  email                            String?
  phone                            String?
  address                          Json?
  logo                             String?
  website                          String?
  description                      String?
  ownerId                          String                      @unique
  isActive                         Boolean                     @default(false)
  isVerified                       Boolean                     @default(false)
  autoAssignTimeoutSeconds         Int                         @default(30)
  autoDispatchEnabled              Boolean                     @default(true)
  dispatchStrategy                 String                      @default("ZONE_QUEUE")
  maxDispatchRadiusKm              Float                       @default(5.0)
  alarms                           alarms[]
  billing_records                  billing_records[]
  users_companies_ownerIdTousers   User                        @relation("companies_ownerIdTousers", fields: [ownerId], references: [id])
  subscription_plans               subscription_plans?         @relation(fields: [subscriptionPlanId], references: [id])
  company_configurations           company_configurations[]
  company_documents                company_documents[]
  company_drivers                  company_drivers[]
  company_payments                 company_payments[]
  company_settings                 company_settings?
  company_tariffs                  company_tariffs[]
  company_vehicles                 company_vehicles[]
  company_zones                    company_zones[]
  delivery_orders                  delivery_orders[]
  driver_earnings                  driver_earnings[]
  driver_earnings_summaries        driver_earnings_summaries[]
  invoices                         invoices[]
  jobs                             Job[]
  merchants                        merchants[]
  payments                         payments[]
  payouts                          payouts[]
  pricing_templates                pricing_templates[]
  rides                            rides[]
  settlements                      settlements[]
  shifts                           Shift[]
  support_tickets                  support_tickets[]
  tariffs                          tariffs[]
  users_users_companyIdTocompanies User[]                      @relation("users_companyIdTocompanies")
  vehicles                         vehicles[]
  zones                            zones[]
  jobMeterSnapshots                job_meter_snapshots[]
}

model company_configurations {
  id                    String                 @id
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  companyId             String
  globalConfigId        String?
  key                   String
  category              String
  displayName           String
  description           String?
  dataType              String
  value                 Json
  inheritFromGlobal     Boolean                @default(true)
  isActive              Boolean                @default(true)
  createdBy             String?
  lastUpdatedBy         String?
  version               Int                    @default(1)
  companies             companies              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  global_configurations global_configurations? @relation(fields: [globalConfigId], references: [id])

  @@unique([companyId, key])
}

model company_documents {
  id                                          String              @id
  createdAt                                   DateTime            @default(now())
  updatedAt                                   DateTime
  companyId                                   String
  type                                        CompanyDocumentType
  description                                 String?
  fileName                                    String
  fileUrl                                     String
  storagePath                                 String
  fileSize                                    Int?
  status                                      DocumentStatus      @default(PENDING)
  uploadedById                                String?
  reviewedById                                String?
  reviewedAt                                  DateTime?
  rejectionReason                             String?
  expiresAt                                   DateTime?
  metadata                                    Json?
  companies                                   companies           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users_company_documents_reviewedByIdTousers User?               @relation("company_documents_reviewedByIdTousers", fields: [reviewedById], references: [id])
  users_company_documents_uploadedByIdTousers User?               @relation("company_documents_uploadedByIdTousers", fields: [uploadedById], references: [id])
}

model company_drivers {
  id                    String    @id
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  companyId             String
  userId                String
  employmentType        String
  hireDate              DateTime
  contractExpiry        DateTime?
  shiftPattern          String?
  licenseNumber         String
  licenseExpiry         DateTime
  backgroundCheckStatus String    @default("PENDING")
  backgroundCheckExpiry DateTime?
  trainingCompletedAt   DateTime?
  panicContactName      String?
  panicContactPhone     String?
  status                String    @default("ACTIVE")
  companies             companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users                 User      @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
}

model company_payments {
  id              String           @id
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  companyId       String
  billingRecordId Int?
  invoiceId       String?
  amount          Float
  paymentMethod   String
  paymentDate     DateTime         @default(now())
  transactionId   String?
  gatewayProvider String?
  gatewayResponse Json?
  status          String           @default("completed")
  failureReason   String?
  processedBy     String?
  notes           String?
  receiptUrl      String?
  billing_records billing_records? @relation(fields: [billingRecordId], references: [id])
  companies       companies        @relation(fields: [companyId], references: [id])
  invoices        invoices?        @relation(fields: [invoiceId], references: [id])
}

model company_settings {
  id                     String    @id
  createdAt              DateTime  @default(now())
  updatedAt              DateTime
  companyId              String    @unique
  mapProvider            String    @default("OPENSTREETMAP")
  googleMapsApiKey       String?
  placeApiProvider       String    @default("OPENSTREETMAP")
  defaultLanguage        String    @default("en")
  defaultCurrency        String    @default("USD")
  timezone               String    @default("UTC")
  locationUpdateInterval Int       @default(2)
  heartbeatInterval      Int       @default(30)
  stripePublicKey        String?
  stripeSecretKey        String?
  companies              companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model company_tariffs {
  id                  String         @id
  createdAt           DateTime       @default(now())
  updatedAt           DateTime
  companyId           String
  name                String?
  description         String?
  serviceMode         String
  vehicleType         String
  zoneId              String?
  baseFare            Float
  perKmRate           Float
  perMinuteRate       Float
  minimumFare         Float
  waitingFeePerMinute Float          @default(0)
  cancellationFee     Float          @default(0)
  bookingFee          Float          @default(0)
  airportFee          Float          @default(0)
  peakHourMultiplier  Float?
  peakHourStart       String?
  peakHourEnd         String?
  peakHour2Start      String?
  peakHour2End        String?
  weekendMultiplier   Float?
  nightMultiplier     Float?
  nightStart          String?
  nightEnd            String?
  validFrom           DateTime       @default(now())
  validTo             DateTime?
  priority            Int            @default(0)
  isActive            Boolean        @default(true)
  currency            String         @default("USD")
  taxRate             Float          @default(0)
  promoStackRulesJson Json?
  companies           companies      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  company_zones       company_zones? @relation(fields: [zoneId], references: [id])

  @@index([companyId])
  @@index([serviceMode])
  @@index([vehicleType])
  @@index([zoneId])
}

model company_vehicles {
  id                   String    @id
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
  companyId            String
  vehicleIdExternal    String?
  make                 String
  model                String
  year                 Int
  bodyType             String
  vehicleClass         String
  ownershipType        String
  capacityPassengers   Int       @default(4)
  capacityBags         Int       @default(2)
  wheelchairAccessible Boolean   @default(false)
  dispatchCallsign     String?
  registrationNumber   String
  registrationExpiry   DateTime?
  insuranceExpiry      DateTime?
  inspectionExpiry     DateTime?
  gpsProvider          String?
  status               String    @default("ACTIVE")
  notes                String?
  companies            companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model company_zones {
  id              String            @id
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  companyId       String
  zoneName        String
  zoneType        String
  geometryType    String            @default("POLYGON")
  polygonGeojson  Json?
  coordinates     Json?
  centerPoint     Json?
  radius          Float?
  bounds          Json?
  color           String            @default("#3B82F6")
  fillOpacity     Float             @default(0.3)
  strokeWeight    Int               @default(2)
  icon            String?
  priceMultiplier Float             @default(1.0)
  pickupAllowed   Boolean           @default(true)
  dropoffAllowed  Boolean           @default(true)
  priority        Int               @default(0)
  notes           String?
  description     String?
  area            Float?
  perimeter       Float?
  totalRides      Int               @default(0)
  activeRides     Int               @default(0)
  isActive        Boolean           @default(true)
  status          String            @default("ACTIVE")
  company_tariffs company_tariffs[]
  companies       companies         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([zoneType])
}

model countries {
  id             String           @id
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  name           String           @unique
  code           String           @unique
  code3          String?          @unique
  numericCode    String?
  phoneCode      String?
  currency       String?
  flag           String?
  isActive       Boolean          @default(true)
  service_cities service_cities[]
}

model currencies {
  id            String   @id
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  name          String   @unique
  code          String   @unique
  symbol        String
  decimalPlaces Int      @default(2)
  isActive      Boolean  @default(true)
}

model delivery_orders {
  id               String         @id
  orderId          String         @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  companyId        String
  customerId       String
  type             DeliveryType   @default(FOOD)
  merchantId       String?
  pickupLocation   Json
  dropoffLocation  Json
  items            Json
  totalAmount      Decimal        @db.Decimal(10, 2)
  deliveryFee      Decimal        @db.Decimal(10, 2)
  status           DeliveryStatus @default(CREATED)
  confirmedAt      DateTime?
  readyForPickupAt DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  proofOfDelivery  Json?
  companies        companies      @relation(fields: [companyId], references: [id])
  users            User           @relation(fields: [customerId], references: [id])
  merchants        merchants?     @relation(fields: [merchantId], references: [id])
  jobs             Job[]
  payments         payments[]
  ratings          ratings[]
}

model document_types {
  id             String   @id
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  name           String   @unique
  code           String   @unique
  description    String?
  category       String   @default("GENERAL")
  isRequired     Boolean  @default(false)
  expiryRequired Boolean  @default(false)
  isActive       Boolean  @default(true)
}

model documents {
  id              String         @id
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  driverId        String
  type            DocumentType
  documentNumber  String?
  fileUrl         String
  fileName        String
  fileSize        Int?
  issueDate       DateTime?
  expiryDate      DateTime?
  status          DocumentStatus @default(PENDING)
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  users           User           @relation(fields: [driverId], references: [id])
}

model driver_earnings {
  id                String    @id
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  driverId          String
  companyId         String
  jobId             String?
  paymentId         String?
  shiftId           String?
  amount            Decimal   @db.Decimal(10, 2)
  currency          String    @default("NZD")
  paymentMethod     String
  earnedAt          DateTime  @default(now())
  baseFare          Decimal?  @default(0.00) @db.Decimal(10, 2)
  distanceFare      Decimal?  @default(0.00) @db.Decimal(10, 2)
  timeFare          Decimal?  @default(0.00) @db.Decimal(10, 2)
  waitingFare       Decimal?  @default(0.00) @db.Decimal(10, 2)
  extraAmount       Decimal?  @default(0.00) @db.Decimal(10, 2)
  discountAmount    Decimal?  @default(0.00) @db.Decimal(10, 2)
  totalAmount       Decimal   @db.Decimal(10, 2)
  companyCommission Decimal?  @default(0.00) @db.Decimal(10, 2)
  driverEarnings    Decimal   @db.Decimal(10, 2)
  commissionRate    Decimal?  @default(0.20) @db.Decimal(5, 4)
  totalMobility     Boolean   @default(false)
  adjustmentReason  String?
  isAdjustment      Boolean   @default(false)
  tripDistance      Decimal?  @db.Decimal(10, 2)
  tripDuration      Int?
  pickupAddress     String?
  dropoffAddress    String?
  customerName      String?
  metadata          Json?
  companies         companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users             User      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  jobs              Job?      @relation(fields: [jobId], references: [id])
  payments          payments? @relation(fields: [paymentId], references: [id])
  shifts            Shift?    @relation(fields: [shiftId], references: [id])

  @@index([companyId, earnedAt(sort: Desc)])
  @@index([driverId, earnedAt(sort: Desc)])
  @@index([earnedAt(sort: Desc)])
  @@index([jobId])
  @@index([paymentMethod])
}

model driver_earnings_summaries {
  id                     String    @id
  createdAt              DateTime  @default(now())
  updatedAt              DateTime
  driverId               String
  companyId              String
  periodType             String
  periodStart            DateTime
  periodEnd              DateTime
  periodLabel            String
  totalEarnings          Decimal   @default(0.00) @db.Decimal(10, 2)
  totalTrips             Int       @default(0)
  totalDistance          Decimal?  @default(0.00) @db.Decimal(10, 2)
  totalDuration          Int?      @default(0)
  cashEarnings           Decimal?  @default(0.00) @db.Decimal(10, 2)
  cashTrips              Int?      @default(0)
  cardEarnings           Decimal?  @default(0.00) @db.Decimal(10, 2)
  cardTrips              Int?      @default(0)
  eftposEarnings         Decimal?  @default(0.00) @db.Decimal(10, 2)
  eftposTrips            Int?      @default(0)
  accountEarnings        Decimal?  @default(0.00) @db.Decimal(10, 2)
  accountTrips           Int?      @default(0)
  giftCardEarnings       Decimal?  @default(0.00) @db.Decimal(10, 2)
  giftCardTrips          Int?      @default(0)
  totalMobilityEarnings  Decimal?  @default(0.00) @db.Decimal(10, 2)
  totalMobilityTrips     Int?      @default(0)
  adjustmentEarnings     Decimal?  @default(0.00) @db.Decimal(10, 2)
  adjustmentTrips        Int?      @default(0)
  totalCompanyCommission Decimal?  @default(0.00) @db.Decimal(10, 2)
  averageCommissionRate  Decimal?  @default(0.20) @db.Decimal(5, 4)
  totalBaseFare          Decimal?  @default(0.00) @db.Decimal(10, 2)
  totalDistanceFare      Decimal?  @default(0.00) @db.Decimal(10, 2)
  totalTimeFare          Decimal?  @default(0.00) @db.Decimal(10, 2)
  totalWaitingFare       Decimal?  @default(0.00) @db.Decimal(10, 2)
  totalExtraAmount       Decimal?  @default(0.00) @db.Decimal(10, 2)
  totalDiscountAmount    Decimal?  @default(0.00) @db.Decimal(10, 2)
  metadata               Json?
  companies              companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users                  User      @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, periodType, periodLabel])
  @@index([companyId, periodType, periodStart(sort: Desc)])
  @@index([driverId, periodType, periodStart(sort: Desc)])
}

model driver_preferences {
  id               String   @id
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  driverId         String   @unique
  selectedZoneId   String?
  selectedTariffId String?
  users            User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tariffs          tariffs? @relation(fields: [selectedTariffId], references: [id])
  zones            zones?   @relation(fields: [selectedZoneId], references: [id])
}

model fare_types {
  id          String   @id
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
}

model global_configurations {
  id                     String                   @id
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  key                    String                   @unique
  category               String
  displayName            String
  description            String?
  dataType               String
  value                  Json
  isActive               Boolean                  @default(true)
  createdBy              String?
  lastUpdatedBy          String?
  version                Int                      @default(1)
  company_configurations company_configurations[]
}

model invoices {
  id                 String             @id
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  invoiceNumber      String             @unique
  companyId          String
  billingRecordId    Int                @unique
  issueDate          DateTime           @default(now())
  dueDate            DateTime
  subtotal           Float
  taxAmount          Float              @default(0.0)
  totalAmount        Float
  status             String             @default("issued")
  sentAt             DateTime?
  paidAt             DateTime?
  lineItems          Json
  notes              String?
  termsAndConditions String?
  filePath           String?
  company_payments   company_payments[]
  billing_records    billing_records    @relation(fields: [billingRecordId], references: [id])
  companies          companies          @relation(fields: [companyId], references: [id])
}

model Job {
  id                                 String                @id
  jobId                              String                @unique
  createdAt                          DateTime              @default(now())
  updatedAt                          DateTime
  companyId                          String
  type                               JobType               @default(TAXI)
  status                             JobStatus             @default(PENDING)
  tripId                             String?
  deliveryOrderId                    String?
  priority                           Int                   @default(0)
  scheduledAt                        DateTime?
  estimatedDuration                  Int?
  customerId                         String?
  vehicleType                        VehicleType?
  pickupAddress                      String?
  pickupLatitude                     Float?
  pickupLongitude                    Float?
  dropoffAddress                     String?
  dropoffLatitude                    Float?
  dropoffLongitude                   Float?
  estimatedPrice                     Float?
  estimatedDistance                  Float?
  estimatedArrival                   DateTime?
  completedAt                        DateTime?
  paymentMethod                      PaymentMethod?
  assignedDriverId                   String?
  requirements                       Json?
  instructions                       String?
  actualFare                         Decimal?              @db.Decimal(10, 2)
  finalAmount                        Decimal?              @db.Decimal(10, 2)
  actualDistanceKm                   Float?
  actualDurationSeconds              Int?
  startedAt                          DateTime?
  alarms                             alarms[]
  assignments                        assignments[]
  driver_earnings                    driver_earnings[]
  users_jobs_assignedDriverIdTousers User?                 @relation("jobs_assignedDriverIdTousers", fields: [assignedDriverId], references: [id])
  companies                          companies             @relation(fields: [companyId], references: [id])
  users_jobs_customerIdTousers       User?                 @relation("jobs_customerIdTousers", fields: [customerId], references: [id])
