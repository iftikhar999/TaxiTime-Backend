generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                  @id @default(cuid())
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  deletedAt                DateTime?
  firstName                String
  lastName                 String
  email                    String                  @unique
  phone                    String                  @unique
  password                 String
  avatar                   String?
  role                     UserRole                @default(PASSENGER)
  isActive                 Boolean                 @default(true)
  isVerified               Boolean                 @default(false)
  lastLoginAt              DateTime?
  verificationToken        String?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  address                  Json?
  preferences              Json?
  rating                   Json?
  companyId                String?
  driverAlarms             Alarm[]                 @relation("DriverAlarms")
  assignments              Assignment[]            @relation("DriverAssignments")
  ownedCompany             Company?                @relation("CompanyOwner")
  reviewedCompanyDocuments CompanyDocument[]       @relation("CompanyDocumentReviewedBy")
  uploadedCompanyDocuments CompanyDocument[]       @relation("CompanyDocumentUploadedBy")
  companyDriverProfile     CompanyDriver[]         @relation("CompanyDriverProfile")
  customerDeliveries       DeliveryOrder[]         @relation("CustomerDeliveries")
  documents                Document[]              @relation("DriverDocuments")
  assignedJobs             Job[]                   @relation("JobAssignedDriver")
  customerJobs             Job[]                   @relation("CustomerJobs")
  locationUpdates          LocationUpdate[]        @relation("DriverLocations")
  receivedMessages         Message[]               @relation("ReceivedMessages")
  sentMessages             Message[]               @relation("SentMessages")
  notifications            Notification[]
  offers                   Offer[]                 @relation("DriverOffers")
  customerPayments         Payment[]               @relation("CustomerPayments")
  driverPayments           Payment[]               @relation("DriverPayments")
  processedPayouts         Payout[]                @relation("ProcessedPayouts")
  receivedRatings          Rating[]                @relation("ReceivedRatings")
  givenRatings             Rating[]                @relation("GivenRatings")
  rideOffers               RideOffer[]             @relation("DriverRideOffers")
  driverRides              Ride[]                  @relation("DriverRides")
  passengerRides           Ride[]                  @relation("PassengerRides")
  processedSettlements     Settlement[]            @relation("ProcessedSettlements")
  shifts                   Shift[]                 @relation("DriverShifts")
  assignedTickets          SupportTicket[]         @relation("AssignedTickets")
  reportedTickets          SupportTicket[]         @relation("ReportedTickets")
  company                  Company?                @relation("CompanyUsers", fields: [companyId], references: [id])
  walletTransactions       WalletTransaction[]
  driverEarnings           DriverEarning[]         @relation("DriverEarnings")
  driverEarningsSummaries  DriverEarningsSummary[] @relation("DriverEarningsSummaries")
  DriverPreferences        DriverPreferences?

  @@map("users")
}

model Company {
  id                               String                  @id @default(cuid())
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt
  deletedAt                        DateTime?
  tenantId                         String?
  legalName                        String?
  brandName                        String?
  companyCode                      String?                 @unique
  companyType                      String                  @default("TAXI_OPERATOR")
  businessModel                    String                  @default("B2C")
  registrationNumber               String?
  taxId                            String?
  primaryLanguage                  String                  @default("en")
  timezone                         String                  @default("UTC")
  status                           String                  @default("PENDING")
  activationDate                   DateTime?
  primaryContactName               String?
  primaryContactRole               String?
  primaryContactEmail              String?
  primaryContactPhone              String?
  supportEmail                     String?
  supportPhone                     String?
  billingEmail                     String?
  hqAddressLine1                   String?
  hqAddressLine2                   String?
  hqCity                           String?
  hqState                          String?
  hqPostcode                       String?
  hqCountry                        String?
  hqLatitude                       Float?
  hqLongitude                      Float?
  kycStatus                        String                  @default("PENDING")
  kycLastReviewedAt                DateTime?
  kycExpiryAt                      DateTime?
  docCertificateOfIncorporationUrl String?
  docTaxCertificateUrl             String?
  docInsurancePolicyUrl            String?
  docOperatingLicenseUrl           String?
  insurancePolicyNumber            String?
  insuranceExpiryDate              DateTime?
  permitNumber                     String?
  permitExpiryDate                 DateTime?
  serviceModes                     Json?
  operatingHoursJson               Json?
  holidayCalendarJson              Json?
  dispatchMode                     String                  @default("AUTO")
  autoAssignRadiusKm               Float                   @default(5.0)
  maxParallelOffers                Int                     @default(3)
  escalationSlaSeconds             Int                     @default(300)
  driverBreakPolicyJson            Json?
  vehicleAgeLimitYears             Int?                    @default(15)
  requiresVehicleInspection        Boolean                 @default(true)
  billingCycle                     String                  @default("MONTHLY")
  billingStartDate                 DateTime?
  billingCurrency                  String                  @default("USD")
  commissionModel                  String                  @default("PERCENTAGE")
  commissionRate                   Float                   @default(15.0)
  driverPayoutFrequency            String                  @default("WEEKLY")
  settlementThresholdAmount        Float                   @default(100.0)
  paymentGatewayAccountId          String?
  stripeConnectedAccountId         String?
  invoiceDeliveryMethod            String                  @default("EMAIL")
  latePaymentPolicyJson            Json?
  walletEnabled                    Boolean                 @default(false)
  walletTopupMinimum               Float                   @default(50.0)
  subscriptionPlanId               Int?
  subscriptionStartDate            DateTime?
  subscriptionEndDate              DateTime?
  trialEndDate                     DateTime?
  lastPaymentDate                  DateTime?
  nextBillingDate                  DateTime?
  suspendedAt                      DateTime?
  suspendedBy                      String?
  reactivatedAt                    DateTime?
  reactivatedBy                    String?
  subscriptionUpdatedAt            DateTime?
  subscriptionUpdatedBy            String?
  fleetSizeTotal                   Int                     @default(0)
  fleetCompanyOwnedCount           Int                     @default(0)
  fleetDriverOwnedCount            Int                     @default(0)
  fleetActiveVehicleCount          Int                     @default(0)
  fleetInserviceVehicleCount       Int                     @default(0)
  fleetOutofserviceVehicleCount    Int                     @default(0)
  fleetAvgVehicleAgeYears          Float                   @default(0)
  fleetHasEvCount                  Int                     @default(0)
  voipProvider                     String?
  voipAccountId                    String?
  voipMaskingEnabled               Boolean                 @default(false)
  cctvProvider                     String?
  cctvAccountId                    String?
  telematicsProvider               String?
  telematicsApiKey                 String?
  smsSenderId                      String?
  emailSenderDomain                String?
  webhookEndpointUrl               String?
  webhookSecret                    String?
  apiClientId                      String?
  apiClientSecretHash              String?
  kpiTargetsJson                   Json?
  alertRecipientEmails             String[]
  alertRecipientSms                String[]
  panicEscalationContactsJson      Json?
  reportingTimezone                String                  @default("UTC")
  dataRetentionDays                Int                     @default(2555)
  gdprContactEmail                 String?
  name                             String?
  email                            String?
  phone                            String?
  address                          Json?
  logo                             String?
  website                          String?
  description                      String?
  ownerId                          String                  @unique
  isActive                         Boolean                 @default(false)
  isVerified                       Boolean                 @default(false)
  autoAssignTimeoutSeconds         Int                     @default(30)
  autoDispatchEnabled              Boolean                 @default(true)
  dispatchStrategy                 String                  @default("ZONE_QUEUE")
  maxDispatchRadiusKm              Float                   @default(5.0)
  Alarm                            Alarm[]
  billingRecords                   BillingRecord[]         @relation("CompanyBilling")
  owner                            User                    @relation("CompanyOwner", fields: [ownerId], references: [id])
  subscriptionPlan                 SubscriptionPlan?       @relation("CompanySubscription", fields: [subscriptionPlanId], references: [id])
  configurations                   CompanyConfiguration[]  @relation("CompanyConfigurations")
  companyDocuments                 CompanyDocument[]
  companyDrivers                   CompanyDriver[]
  payments                         CompanyPayment[]        @relation("CompanyPayments")
  settings                         CompanySettings?        @relation("CompanySettings")
  companyTariffs                   CompanyTariff[]
  companyVehicles                  CompanyVehicle[]
  companyZones                     CompanyZone[]
  DeliveryOrder                    DeliveryOrder[]
  invoices                         Invoice[]               @relation("CompanyInvoices")
  Job                              Job[]
  Merchant                         Merchant[]
  Payment                          Payment[]
  payouts                          Payout[]                @relation("CompanyPayouts")
  pricingTemplates                 PricingTemplate[]
  rides                            Ride[]
  settlements                      Settlement[]            @relation("CompanySettlements")
  Shift                            Shift[]
  SupportTicket                    SupportTicket[]
  Tariff                           Tariff[]
  users                            User[]                  @relation("CompanyUsers")
  vehicles                         Vehicle[]
  Zone                             Zone[]
  driverEarnings                   DriverEarning[]         @relation("CompanyDriverEarnings")
  driverEarningsSummaries          DriverEarningsSummary[] @relation("CompanyEarningsSummaries")

  @@map("companies")
}

model Ride {
  id                  String           @id @default(cuid())
  rideId              String           @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  passengerId         String
  driverId            String?
  vehicleId           String?
  companyId           String
  rideType            RideType         @default(TAXI)
  pickup              Json
  destination         Json
  stops               Json?
  status              RideStatus       @default(REQUESTED)
  requestedAt         DateTime         @default(now())
  acceptedAt          DateTime?
  pickedUpAt          DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  estimatedDistance   Float?
  actualDistance      Float?
  estimatedDuration   Int?
  actualDuration      Int?
  estimatedFare       Float?
  actualFare          Float?
  fareBreakdown       Json?
  paymentMethod       PaymentMethod    @default(CASH)
  paymentStatus       PaymentStatus    @default(PENDING)
  paymentId           String?
  requirements        Json?
  passengerRating     Json?
  driverRating        Json?
  route               Json?
  cancellationReason  String?
  cancelledBy         String?
  promoCode           String?
  discountAmount      Float?
  foodDeliveryDetails Json?
  courierDetails      Json?
  tariffId            String?
  offeredAt           DateTime?
  Job                 Job[]
  LocationUpdate      LocationUpdate[]
  Payment             Payment[]
  Rating              Rating[]
  RideOffer           RideOffer[]
  company             Company          @relation(fields: [companyId], references: [id])
  driver              User?            @relation("DriverRides", fields: [driverId], references: [id])
  passenger           User             @relation("PassengerRides", fields: [passengerId], references: [id])
  Tariff              Tariff?          @relation(fields: [tariffId], references: [id])
  vehicle             Vehicle?         @relation(fields: [vehicleId], references: [id])
  SupportTicket       SupportTicket[]

  @@map("rides")
}

model RideOffer {
  id              String          @id @default(cuid())
  rideId          String
  driverId        String
  offeredAt       DateTime        @default(now())
  status          RideOfferStatus @default(OFFERED)
  respondedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  driver          User            @relation("DriverRideOffers", fields: [driverId], references: [id])
  ride            Ride            @relation(fields: [rideId], references: [id])

  @@unique([rideId, driverId])
  @@index([rideId, status])
  @@index([driverId, status])
  @@map("ride_offers")
}

model Vehicle {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  make            String
  model           String
  year            Int
  color           String
  licensePlate    String        @unique
  vin             String?       @unique
  vehicleType     VehicleType   @default(SEDAN)
  companyId       String
  driverId        String?
  capacity        Int           @default(4)
  features        Json?
  isActive        Boolean       @default(true)
  isAvailable     Boolean       @default(true)
  insurance       Json?
  registration    Json?
  currentLocation Json?
  rides           Ride[]
  vehicleZones    VehicleZone[]
  company         Company       @relation(fields: [companyId], references: [id])

  @@map("vehicles")
}

model Job {
  id                String           @id @default(cuid())
  jobId             String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  companyId         String
  type              JobType          @default(TAXI)
  status            JobStatus        @default(PENDING)
  tripId            String?
  deliveryOrderId   String?
  priority          Int              @default(0)
  scheduledAt       DateTime?
  estimatedDuration Int?
  customerId        String?
  vehicleType       VehicleType?
  pickupAddress     String?
  pickupLatitude    Float?
  pickupLongitude   Float?
  dropoffAddress    String?
  dropoffLatitude   Float?
  dropoffLongitude  Float?
  estimatedPrice    Float?
  estimatedDistance Float?
  estimatedArrival  DateTime?
  paymentMethod     PaymentMethod?
  actualFare        Decimal?         @db.Decimal(10, 2)
  finalAmount       Decimal?         @db.Decimal(10, 2)
  completedAt       DateTime?
  assignedDriverId  String?
  requirements      Json?
  instructions      String?
  alarms            Alarm[]
  assignments       Assignment[]
  assignedDriver    User?            @relation("JobAssignedDriver", fields: [assignedDriverId], references: [id])
  company           Company          @relation(fields: [companyId], references: [id])
  customer          User?            @relation("CustomerJobs", fields: [customerId], references: [id])
  deliveryOrder     DeliveryOrder?   @relation(fields: [deliveryOrderId], references: [id])
  trip              Ride?            @relation(fields: [tripId], references: [id])
  locationUpdates   LocationUpdate[]
  messages          Message[]
  offers            Offer[]
  earnings          DriverEarning[]
  payments          Payment[]

  @@index([assignedDriverId, updatedAt])
  @@index([assignedDriverId, completedAt])
  @@index([status, completedAt])
  @@map("jobs")
}

model DeliveryOrder {
  id               String         @id @default(cuid())
  orderId          String         @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  companyId        String
  customerId       String
  type             DeliveryType   @default(FOOD)
  merchantId       String?
  pickupLocation   Json
  dropoffLocation  Json
  items            Json
  totalAmount      Decimal        @db.Decimal(10, 2)
  deliveryFee      Decimal        @db.Decimal(10, 2)
  status           DeliveryStatus @default(CREATED)
  confirmedAt      DateTime?
  readyForPickupAt DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  proofOfDelivery  Json?
  company          Company        @relation(fields: [companyId], references: [id])
  customer         User           @relation("CustomerDeliveries", fields: [customerId], references: [id])
  merchant         Merchant?      @relation(fields: [merchantId], references: [id])
  jobs             Job[]
  payments         Payment[]
  ratings          Rating[]

  @@map("delivery_orders")
}

model Merchant {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  name           String
  email          String          @unique
  phone          String
  address        Json
  logo           String?
  description    String?
  companyId      String
  businessType   String
  cuisine        String[]
  priceRange     String?
  rating         Float?          @default(0)
  ratingCount    Int?            @default(0)
  isActive       Boolean         @default(true)
  isOpen         Boolean         @default(false)
  operatingHours Json?
  menu           Json?
  commissionRate Decimal         @default(15.00) @db.Decimal(5, 2)
  deliveryOrders DeliveryOrder[]
  company        Company         @relation(fields: [companyId], references: [id])

  @@map("merchants")
}

model Zone {
  id                String              @id @default(cuid())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  companyId         String
  name              String
  description       String?
  boundaries        Json
  type              ZoneType            @default(SERVICE_AREA)
  surgeMultiplier   Decimal?            @db.Decimal(3, 2)
  isActive          Boolean             @default(true)
  specialRules      Json?
  queue             Json?               @default("[]")
  vehicleZones      VehicleZone[]
  zoneTariffs       ZoneTariff[]
  company           Company             @relation(fields: [companyId], references: [id])
  DriverPreferences DriverPreferences[]

  @@map("zones")
}

model Tariff {
  id                  String              @id @default(cuid())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  companyId           String
  name                String
  description         String?
  baseFare            Decimal             @db.Decimal(10, 2)
  perKmRate           Decimal             @db.Decimal(10, 2)
  perMinuteRate       Decimal             @db.Decimal(10, 2)
  minimumFare         Decimal             @db.Decimal(10, 2)
  waitingFee          Decimal?            @db.Decimal(10, 2)
  airportFee          Decimal?            @db.Decimal(10, 2)
  tollFee             Decimal?            @db.Decimal(10, 2)
  extraStopFee        Decimal?            @db.Decimal(10, 2)
  peakHourMultiplier  Decimal?            @db.Decimal(3, 2)
  nightTimeMultiplier Decimal?            @db.Decimal(3, 2)
  maxSurgeMultiplier  Decimal?            @default(3.0) @db.Decimal(3, 2)
  isActive            Boolean             @default(true)
  validFrom           DateTime?
  validTo             DateTime?
  rides               Ride[]
  company             Company             @relation(fields: [companyId], references: [id])
  zoneTariffs         ZoneTariff[]
  DriverPreferences   DriverPreferences[]

  @@map("tariffs")
}

model LocationUpdate {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  driverId     String
  jobId        String?
  tripId       String?
  latitude     Float
  longitude    Float
  accuracy     Float?
  altitude     Float?
  speed        Float?
  heading      Float?
  batteryLevel Int?
  networkType  String?
  timestamp    DateTime?
  driver       User      @relation("DriverLocations", fields: [driverId], references: [id])
  job          Job?      @relation(fields: [jobId], references: [id])
  trip         Ride?     @relation(fields: [tripId], references: [id])

  @@map("location_updates")
}

model Offer {
  id                String         @id @default(cuid())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  jobId             String
  driverId          String
  estimatedFare     Decimal        @db.Decimal(10, 2)
  estimatedDuration Int
  distanceToPickup  Float
  status            OfferStatus    @default(SENT)
  expiresAt         DateTime
  respondedAt       DateTime?
  response          OfferResponse?
  declineReason     String?
  driver            User           @relation("DriverOffers", fields: [driverId], references: [id])
  job               Job            @relation(fields: [jobId], references: [id])

  @@map("offers")
}

model Assignment {
  id              String           @id @default(cuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobId           String
  driverId        String
  assignedBy      String
  assignedAt      DateTime         @default(now())
  status          AssignmentStatus @default(ASSIGNED)
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  driver          User             @relation("DriverAssignments", fields: [driverId], references: [id])
  job             Job              @relation(fields: [jobId], references: [id])

  @@map("assignments")
}

model Payment {
  id                    String              @id @default(cuid())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  companyId             String
  tripId                String?
  deliveryOrderId       String?
  customerId            String
  driverId              String?
  jobId                 String?
  amount                Decimal             @db.Decimal(10, 2)
  currency              String              @default("USD")
  paymentMethod         PaymentMethod       @default(CASH)
  paymentProvider       String?
  providerTransactionId String?
  status                PaymentStatus       @default(PENDING)
  baseAmount            Decimal?            @db.Decimal(10, 2)
  tips                  Decimal?            @db.Decimal(10, 2)
  taxes                 Decimal?            @db.Decimal(10, 2)
  fees                  Decimal?            @db.Decimal(10, 2)
  discounts             Decimal?            @db.Decimal(10, 2)
  driverEarnings        Decimal?            @db.Decimal(10, 2)
  paidAt                DateTime?
  processedAt           DateTime?
  failureReason         String?
  stripePaymentIntentId String?             @unique
  stripeCustomerId      String?
  completedAt           DateTime?
  refundedAt            DateTime?
  refundAmount          Decimal?            @db.Decimal(10, 2)
  refundReason          String?
  settledAt             DateTime?
  settlementNotes       String?
  metadata              Json?
  company               Company             @relation(fields: [companyId], references: [id])
  customer              User                @relation("CustomerPayments", fields: [customerId], references: [id])
  driver                User?               @relation("DriverPayments", fields: [driverId], references: [id])
  job                   Job?                @relation(fields: [jobId], references: [id])
  deliveryOrder         DeliveryOrder?      @relation(fields: [deliveryOrderId], references: [id])
  trip                  Ride?               @relation(fields: [tripId], references: [id])
  WalletTransaction     WalletTransaction[]
  DriverEarnings        DriverEarning[]

  @@index([driverId, paidAt])
  @@index([jobId])
  @@map("payments")
}

model WalletTransaction {
  id            String                @id @default(cuid())
  createdAt     DateTime              @default(now())
  userId        String
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(10, 2)
  currency      String                @default("USD")
  description   String?
  balanceBefore Decimal               @db.Decimal(10, 2)
  balanceAfter  Decimal               @db.Decimal(10, 2)
  paymentId     String?
  payment       Payment?              @relation(fields: [paymentId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])

  @@map("wallet_transactions")
}

model DriverEarning {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driverId  String
  companyId String
  jobId     String?
  paymentId String?
  shiftId   String?

  // Earnings details
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("NZD")
  paymentMethod String
  earnedAt      DateTime @default(now())

  // Trip breakdown
  baseFare       Decimal? @default(0.00) @db.Decimal(10, 2)
  distanceFare   Decimal? @default(0.00) @db.Decimal(10, 2)
  timeFare       Decimal? @default(0.00) @db.Decimal(10, 2)
  waitingFare    Decimal? @default(0.00) @db.Decimal(10, 2)
  extraAmount    Decimal? @default(0.00) @db.Decimal(10, 2)
  discountAmount Decimal? @default(0.00) @db.Decimal(10, 2)

  // Commission & splits
  totalAmount       Decimal  @db.Decimal(10, 2)
  companyCommission Decimal? @default(0.00) @db.Decimal(10, 2)
  driverEarnings    Decimal  @db.Decimal(10, 2)
  commissionRate    Decimal? @default(0.20) @db.Decimal(5, 4)

  // Special flags
  totalMobility    Boolean @default(false)
  adjustmentReason String?
  isAdjustment     Boolean @default(false)

  // Metadata
  tripDistance   Decimal? @db.Decimal(10, 2)
  tripDuration   Int?
  pickupAddress  String?
  dropoffAddress String?
  customerName   String?
  metadata       Json?

  // Relations
  driver  User     @relation("DriverEarnings", fields: [driverId], references: [id], onDelete: Cascade)
  company Company  @relation("CompanyDriverEarnings", fields: [companyId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  shift   Shift?   @relation("ShiftEarnings", fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([driverId, earnedAt(sort: Desc)])
  @@index([companyId, earnedAt(sort: Desc)])
  @@index([paymentMethod])
  @@index([earnedAt(sort: Desc)])
  @@index([jobId])
  @@map("driver_earnings")
}

model DriverEarningsSummary {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driverId  String
  companyId String

  // Time period
  periodType  String // 'DAILY', 'WEEKLY', 'MONTHLY'
  periodStart DateTime
  periodEnd   DateTime
  periodLabel String // e.g., '2025-10-31', '2025-W44', '2025-10'

  // Aggregated earnings
  totalEarnings Decimal  @default(0.00) @db.Decimal(10, 2)
  totalTrips    Int      @default(0)
  totalDistance Decimal? @default(0.00) @db.Decimal(10, 2)
  totalDuration Int?     @default(0)

  // Payment method breakdown
  cashEarnings     Decimal? @default(0.00) @db.Decimal(10, 2)
  cashTrips        Int?     @default(0)
  cardEarnings     Decimal? @default(0.00) @db.Decimal(10, 2)
  cardTrips        Int?     @default(0)
  eftposEarnings   Decimal? @default(0.00) @db.Decimal(10, 2)
  eftposTrips      Int?     @default(0)
  accountEarnings  Decimal? @default(0.00) @db.Decimal(10, 2)
  accountTrips     Int?     @default(0)
  giftCardEarnings Decimal? @default(0.00) @db.Decimal(10, 2)
  giftCardTrips    Int?     @default(0)

  // Special categories
  totalMobilityEarnings Decimal? @default(0.00) @db.Decimal(10, 2)
  totalMobilityTrips    Int?     @default(0)
  adjustmentEarnings    Decimal? @default(0.00) @db.Decimal(10, 2)
  adjustmentTrips       Int?     @default(0)

  // Commission totals
  totalCompanyCommission Decimal? @default(0.00) @db.Decimal(10, 2)
  averageCommissionRate  Decimal? @default(0.20) @db.Decimal(5, 4)

  // Fare breakdown
  totalBaseFare       Decimal? @default(0.00) @db.Decimal(10, 2)
  totalDistanceFare   Decimal? @default(0.00) @db.Decimal(10, 2)
